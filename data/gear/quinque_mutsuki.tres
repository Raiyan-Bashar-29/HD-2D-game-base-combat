[gd_resource type="Resource" script_class="GearDefinition" format=3]

[ext_resource type="Script" path="res://src/content/combat/gear/gear_definition.gd" id="gear"]
[ext_resource type="Resource" path="res://data/gear_types/quinque_armour.tres" id="type"]
[ext_resource type="Script" path="res://src/content/combat/stat_modifier.gd" id="mod"]
[ext_resource type="Script" path="res://src/content/combat/passives/passive_skill.gd" id="pskill"]
[ext_resource type="Resource" path="res://data/passives/weakening_blows.tres" id="weakening_blows"]
[ext_resource type="Resource" path="res://data/passives/quinque_feed.tres" id="quinque_feed"]

[sub_resource type="Resource" id="m0"]
script = ExtResource("mod")
stat = &"speed"
op = 0
value = 2.0

[resource]
script = ExtResource("gear")
id = &"gear/quinque_mutsuki"
item_id = &"item/quinque_mutsuki"
type = ExtResource("type")
modifiers = Array[ExtResource("mod")]([SubResource("m0")])
passives = Array[ExtResource("pskill")]([ExtResource("weakening_blows"), ExtResource("quinque_feed")])
