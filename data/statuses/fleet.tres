[gd_resource type="Resource" script_class="StatusEffect" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/content/combat/status_effect.gd" id="1_status"]
[ext_resource type="Script" path="res://src/content/combat/stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="evasion"]
script = ExtResource("2_mod")
stat = &"evasion"
value = 0.3

[resource]
script = ExtResource("1_status")
id = &"status/fleet"
name_key = "combat.status.fleet.name"
unit = 1
duration = 1.5
modifiers = Array[ExtResource("2_mod")]([SubResource("evasion")])
tags = Array[StringName]([&"buff"])
