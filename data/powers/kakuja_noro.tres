[gd_resource type="Resource" script_class="PowerKit" format=3]

[ext_resource type="Script" path="res://src/content/combat/powers/power_kit.gd" id="kit"]
[ext_resource type="Script" path="res://src/content/combat/powers/power.gd" id="power"]
[ext_resource type="Script" path="res://src/content/combat/powers/mechanisms/form_mechanism.gd" id="form"]
[ext_resource type="Script" path="res://src/content/combat/status_effect.gd" id="status"]
[ext_resource type="Script" path="res://src/content/combat/stat_modifier.gd" id="mod"]
[ext_resource type="Script" path="res://src/content/combat/look_def.gd" id="look"]
[ext_resource type="Script" path="res://src/content/combat/passives/passive_skill.gd" id="pskill"]
[ext_resource type="Resource" path="res://data/passives/kakuja_regen.tres" id="kakuja_regen"]
[ext_resource type="Resource" path="res://data/passives/noro_regrowth.tres" id="noro_regrowth"]
[ext_resource type="Resource" path="res://data/passives/kakuja_hunger.tres" id="kakuja_hunger"]

[sub_resource type="Resource" id="a_m0"]
script = ExtResource("mod")
stat = &"max_hp"
op = 1
value = 1.3

[sub_resource type="Resource" id="a_status"]
script = ExtResource("status")
id = &"status/form_noro"
name_key = "combat.form.noro.name"
duration = 0.0
modifiers = Array[ExtResource("mod")]([SubResource("a_m0")])
tags = Array[StringName]([&"form"])

[sub_resource type="Resource" id="a_look"]
script = ExtResource("look")
look_id = &"look/noro"
tint = Color(0.55, 0.5, 0.6, 1)
scale = 1.25
label_key = "combat.form.noro.name"

[sub_resource type="Resource" id="a_form"]
script = ExtResource("form")
status = SubResource("a_status")
exclusive_group = &"kakuja"
drain_pool = &"rc"
drain_per_second = 2.0
drain_per_turn = 10.0
look = SubResource("a_look")
name_key = "combat.form.noro.name"
passive_skills = Array[ExtResource("pskill")]([ExtResource("kakuja_regen"), ExtResource("noro_regrowth"), ExtResource("kakuja_hunger")])

[sub_resource type="Resource" id="p"]
script = ExtResource("power")
power_id = &"power/kakuja_noro"
name_key = "combat.power.kakuja_noro.name"
desc_key = "combat.power.kakuja_noro.desc"
mechanism = SubResource("a_form")
requires_pool = &"rc"
requires_fraction = 0.1

[sub_resource type="Resource" id="rc"]
script = ExtResource("mod")
stat = &"max_rc"
op = 0
value = 100.0
source = &"kit/kakuja_noro"

[resource]
script = ExtResource("kit")
kit_id = &"kit/kakuja_noro"
name_key = "combat.kit.kakuja_noro.name"
desc_key = "combat.kit.kakuja_noro.desc"
powers = Array[ExtResource("power")]([SubResource("p")])
stat_bonuses = Array[ExtResource("mod")]([SubResource("rc")])
