[gd_resource type="Resource" script_class="PassiveSkill" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/content/combat/passives/passive_skill.gd" id="skill"]
[ext_resource type="Script" path="res://src/content/combat/passives/passive_effect.gd" id="eff"]
[ext_resource type="Script" path="res://src/content/combat/passives/passive_trigger.gd" id="trig"]

[sub_resource type="Resource" id="eff_1"]
