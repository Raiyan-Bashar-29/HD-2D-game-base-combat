[gd_resource type="Resource" script_class="PassiveSkill" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/content/combat/passives/passive_skill.gd" id="skill"]
[ext_resource type="Script" path="res://src/content/combat/stat_modifier.gd" id="mod"]
[ext_resource type="Script" path="res://src/content/combat/status_effect.gd" id="status"]

[sub_resource type="Resource" id="mod_1"]
script = ExtResource("mod")
stat = &"attack"
op = 1
value = 1.1

[sub_resource type="Resource" id="status_2"]
script = ExtResource("status")
id = &"status/passive_strength_up"
duration = 0.0
modifiers = Array[ExtResource("mod")]([SubResource("mod_1")])
tags = Array[StringName]([&"passive"])

[resource]
script = ExtResource("skill")
id = &"passive/strength_up"
name_key = "combat.passive.strength_up.name"
desc_key = "combat.passive.strength_up.desc"
cost = 2
held = SubResource("status_2")
group = &"attack_up"
rank = 1
tags = Array[StringName]([&"offence"])
