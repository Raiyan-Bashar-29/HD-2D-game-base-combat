[gd_resource type="Resource" script_class="PowerKit" format=3]

[ext_resource type="Script" path="res://src/content/combat/powers/power_kit.gd" id="kit"]
[ext_resource type="Script" path="res://src/content/combat/powers/power.gd" id="power"]
[ext_resource type="Script" path="res://src/content/combat/powers/mechanisms/form_mechanism.gd" id="form"]
[ext_resource type="Script" path="res://src/content/combat/status_effect.gd" id="status"]
[ext_resource type="Script" path="res://src/content/combat/stat_modifier.gd" id="mod"]
[ext_resource type="Script" path="res://src/content/combat/look_def.gd" id="look"]
[ext_resource type="Script" path="res://src/content/combat/passives/passive_skill.gd" id="pskill"]
[ext_resource type="Resource" path="res://data/passives/kakuja_shell.tres" id="kakuja_shell"]
[ext_resource type="Resource" path="res://data/passives/kakuja_regen.tres" id="kakuja_regen"]
[ext_resource type="Resource" path="res://data/passives/kakuja_hunger.tres" id="kakuja_hunger"]
[ext_resource type="Resource" path="res://data/passives/centipede_bite.tres" id="centipede_bite"]
[ext_resource type="Resource" path="res://data/passives/frenzy.tres" id="frenzy"]

[sub_resource type="Resource" id="half_m0"]
script = ExtResource("mod")
stat = &"attack"
op = 1
value = 1.15

[sub_resource type="Resource" id="half_m1"]
script = ExtResource("mod")
stat = &"speed"
op = 0
value = 2.0

[sub_resource type="Resource" id="half_status"]
script = ExtResource("status")
id = &"status/form_centipede_half"
name_key = "combat.form.centipede_half.name"
duration = 0.0
modifiers = Array[ExtResource("mod")]([SubResource("half_m0"), SubResource("half_m1")])
tags = Array[StringName]([&"form"])

[sub_resource type="Resource" id="half_look"]
script = ExtResource("look")
look_id = &"look/centipede_half"
tint = Color(0.75, 0.45, 0.55, 1)
scale = 1.05
label_key = "combat.form.centipede_half.name"

[sub_resource type="Resource" id="half_form"]
script = ExtResource("form")
status = SubResource("half_status")
look = SubResource("half_look")
name_key = "combat.form.centipede_half.name"
passive_skills = Array[ExtResource("pskill")]([ExtResource("kakuja_regen"), ExtResource("centipede_bite"), ExtResource("frenzy")])

[sub_resource type="Resource" id="full_m0"]
script = ExtResource("mod")
stat = &"attack"
op = 1
value = 1.5

[sub_resource type="Resource" id="full_m1"]
script = ExtResource("mod")
stat = &"speed"
op = 0
value = 3.0

[sub_resource type="Resource" id="full_status"]
script = ExtResource("status")
id = &"status/form_centipede"
name_key = "combat.form.centipede.name"
duration = 0.0
modifiers = Array[ExtResource("mod")]([SubResource("full_m0"), SubResource("full_m1")])
tags = Array[StringName]([&"form"])

[sub_resource type="Resource" id="full_look"]
script = ExtResource("look")
look_id = &"look/centipede"
tint = Color(0.6, 0.2, 0.3, 1)
scale = 1.15
label_key = "combat.form.centipede.name"

[sub_resource type="Resource" id="full_form"]
script = ExtResource("form")
status = SubResource("full_status")
look = SubResource("full_look")
name_key = "combat.form.centipede.name"
passive_skills = Array[ExtResource("pskill")]([ExtResource("kakuja_shell"), ExtResource("kakuja_regen"), ExtResource("kakuja_hunger"), ExtResource("centipede_bite")])

[sub_resource type="Resource" id="cycle"]
script = ExtResource("form")
exclusive_group = &"kakuja"
drain_pool = &"rc"
drain_per_second = 2.0
drain_per_turn = 10.0
cycle = Array[ExtResource("form")]([SubResource("half_form"), SubResource("full_form")])

[sub_resource type="Resource" id="p"]
script = ExtResource("power")
power_id = &"power/kakuja_centipede"
name_key = "combat.power.kakuja_centipede.name"
desc_key = "combat.power.kakuja_centipede.desc"
mechanism = SubResource("cycle")
requires_pool = &"rc"
requires_fraction = 0.1

[sub_resource type="Resource" id="rc"]
script = ExtResource("mod")
stat = &"max_rc"
op = 0
value = 100.0
source = &"kit/kakuja_centipede"

[resource]
script = ExtResource("kit")
kit_id = &"kit/kakuja_centipede"
name_key = "combat.kit.kakuja_centipede.name"
desc_key = "combat.kit.kakuja_centipede.desc"
powers = Array[ExtResource("power")]([SubResource("p")])
stat_bonuses = Array[ExtResource("mod")]([SubResource("rc")])
