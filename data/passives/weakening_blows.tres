[gd_resource type="Resource" script_class="PassiveSkill" load_steps=7 format=3]

[ext_resource type="Script" path="res://src/content/combat/passives/passive_skill.gd" id="skill"]
[ext_resource type="Resource" path="res://data/statuses/weaken.tres" id="weaken"]
[ext_resource type="Script" path="res://src/content/combat/passives/passive_effect.gd" id="eff"]
[ext_resource type="Script" path="res://src/content/combat/passives/passive_trigger.gd" id="trig"]

[sub_resource type="Resource" id="eff_1"]
script = ExtResource("eff")
kind = 3
target = 1
status = ExtResource("weaken")

[sub_resource type="Resource" id="trig_2"]
script = ExtResource("trig")
event = 3
chance = 0.2
effects = Array[ExtResource("eff")]([SubResource("eff_1")])

[resource]
script = ExtResource("skill")
id = &"passive/weakening_blows"
name_key = "combat.passive.weakening_blows.name"
desc_key = "combat.passive.weakening_blows.desc"
cost = 2
triggers = Array[ExtResource("trig")]([SubResource("trig_2")])
tags = Array[StringName]([&"offence"])
