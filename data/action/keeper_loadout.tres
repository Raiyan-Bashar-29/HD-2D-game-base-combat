[sub_resource type="Resource" id="curve"]
script = ExtResource("2_curve")
growth = Dictionary[StringName, float]({
&"attack": 2.0,
&"max_hp": 6.0
})

[sub_resource type="Resource" id="salve"]
script = ExtResource("1_cmd")
kind = 1
skill = ExtResource("8_salve")

[sub_resource type="Resource" id="bulwark"]
script = ExtResource("1_cmd")
kind = 1
skill = ExtResource("9_bulwark")

[sub_resource type="Resource" id="think_salve"]
script = ExtResource("11_entry")
command = SubResource("salve")
weight = 4.0
target_rule = 2
below_fraction = 0.6

[sub_resource type="Resource" id="think_bulwark"]
script = ExtResource("11_entry")
command = SubResource("bulwark")
target_rule = 2

[sub_resource type="Resource" id="brain"]
script = ExtResource("10_brain")
entries = Array[ExtResource("11_entry")]([SubResource("think_salve"), SubResource("think_bulwark")])

[sub_resource type="Resource" id="keeper"]
script = ExtResource("3_def")
combatant_id = &"keeper_ally"
name_key = "combat.member.keeper.name"
faction = &"player"
base_stats = Dictionary[StringName, float]({
&"attack": 6.0,
&"defence": 16.0,
&"max_hp": 38.0,
&"max_mp": 14.0
})
level_curve = SubResource("curve")
brain = SubResource("brain")

[sub_resource type="Resource" id="staff_one"]
script = ExtResource("4_move")
startup = 0.12
active = 0.14
recovery = 0.3
chain_after = 0.05
power = 3.0
hitbox_size = Vector3(1.4, 1.2, 1.6)
hitbox_offset = Vector3(0, 0.8, -1.0)

[sub_resource type="Resource" id="staff_two"]
script = ExtResource("4_move")
startup = 0.18
active = 0.14
recovery = 0.4
power = 5.0
poise = 1
knockback = 2.5
hitbox_size = Vector3(1.8, 1.2, 1.8)
hitbox_offset = Vector3(0, 0.8, -1.1)

[sub_resource type="Resource" id="roll"]
script = ExtResource("4_move")
startup = 0.0
active = 0.3
recovery = 0.2
iframes_to = 0.3
travel_speed = 5.0

[sub_resource type="Resource" id="moves"]
script = ExtResource("5_set")
attack_chain = Array[ExtResource("4_move")]([SubResource("staff_one"), SubResource("staff_two")])
dodge = SubResource("roll")

[sub_resource type="Resource" id="swing"]
script = ExtResource("13_field_entry")
move = SubResource("staff_one")

[sub_resource type="Resource" id="field_brain"]
script = ExtResource("12_field")
aggro_radius = 5.0
give_up_radius = 8.0
leash_radius = 7.0
attack_range = 1.6
attack_cooldown = 1.2
move_speed = 3.5
moves = Array[ExtResource("13_field_entry")]([SubResource("swing")])

[sub_resource type="Resource" id="atb"]
script = ExtResource("7_atb")

[resource]
script = ExtResource("6_loadout")
fighter = SubResource("keeper")
moves = SubResource("moves")
atb = SubResource("atb")
commands = Array[ExtResource("1_cmd")]([SubResource("salve"), SubResource("bulwark")])
field_brain = SubResource("field_brain")
